{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_ORIGIN": "https://eqosy.com" }
    },
    "user": { "extends": "base", "distribution": "internal", "env": { "EXPO_PUBLIC_APP_VARIANT": "user" } },
    "driver": { "extends": "base", "distribution": "internal", "env": { "EXPO_PUBLIC_APP_VARIANT": "driver" } },
    "delivery": { "extends": "base", "distribution": "internal", "env": { "EXPO_PUBLIC_APP_VARIANT": "delivery" } },
    "restaurant": { "extends": "base", "distribution": "internal", "env": { "EXPO_PUBLIC_APP_VARIANT": "restaurant" } }
  }
}
